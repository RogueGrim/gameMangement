<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Category</title>
</head>
<body>
    <%- include('navbar',{title: 'Game Management App'}) %>

    <form action="/management/edit/<%= item.id %>" method="post">
        
        <label for="game_name">Game Name: </label>
        <input type="text" name="game_name" value="<%= item.game_name %>">
        
        <label for="genre">Genre:</label>
        <input type="text" name="genre" value="<%= item.genre %>">

        <label for="dev_name">Developer Name: </label>
        <input type="text" name="dev_name" value="<%= item.dev_name %>">

        <button type="submit">Submit</button>
    </form>
</body>
</html>