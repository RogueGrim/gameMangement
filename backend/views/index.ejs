<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> </title>
    <link rel="stylesheet" href="/styles.css"> 
</head>
<body>
    <header>
        <h1> <%= title %></h1>
        <%- include('navbar') %>
    </header>
    <section>
        <div class="title">
            <h1>Game</h1>
            <h1>Developer</h1>
            <h1>Genre</h1>
        </div>
        <% data.forEach(item=>{ %>
            <%- include('./layouts/card',{items: item}) %>
        <% }) %>
        
    </section>
</body>
</html>