<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/editGame.css">
    <title>Edit Game</title>
</head>
<body>
    <%- include('navbar',{title: 'Game Management App'}) %>
    <div class="container">
        <a href="/management"><Button>Back</Button></a>
        <form action="/management/editGame/<%= gameData.game_id %>" method="post">
            
            
            <div class="nameField">
                <label for="id">ID:</label>
                <input type="text" name="id" readonly value="<%= gameData.game_id %>">
            </div>
            
            <div class="nameField">
                <label for="game_name">Game Name:</label>
                <input type="text" name="game_name" value="<%= gameData.game_name %>">
            </div>
            
            <div class="genreField">
                <label for="genre">Genre:</label>
                <% genreInfo.forEach(item => { %>
                        <label for="genres">
                            <input 
                                type="checkbox" 
                                name="genres" 
                                value="<%= item.genre_id %>"
                                <%= genreData?.genres_id.includes(item.genre_id) ? "checked" : "" %>
                            > 
                            <%= item.genre %> 
                        </label>
                <% }) %>
            </div>
            
            <div class="selector">
                <label for="dev_name"> Developer Name:</label>
                <select name="dev_id">
                    <option selected >--</option>
                    <% devInfo.forEach(item => { %>
                        <option 
                            value="<%= item.dev_id %>"
                            <%= devData?.dev_id == item.dev_id ? "selected" : "" %>
                        > <%= item.dev_name %> </option>
                    <% }) %>
                </select>
            </div>
            
            <div class="buttons">
                <button type="submit">Submit</button>
                <button
                    type="button"
                    onclick="openPopup({
                        message:'This Action Is Permanent',
                        action: `/management/deleteGame/<%= gameData.game_id %>`
                    })"
                >Delete</button>
            </div>
        </form>
    </div>
    <%- include('./layouts/confirmDel') %>
</body>
</html>