<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Genre</title>
</head>
<body>
    <%- include('navbar',{title: 'Game Management App'}) %>
    <form action="/management/editGenre/<%= item.genre_id %>" method="post">
        <label for="genre_id">Genre ID:</label>
        <input type="text" value="<%= item.genre_id %>" readonly>

        <label for="genre">Genre:</label>
        <input type="text" value="<%= item.genre %>">

        <button type="submit">Submit</button>
    </form>
</body>
</html>