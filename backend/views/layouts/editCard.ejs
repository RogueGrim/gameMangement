<%# ejs module to render cards in Management  %>

<section>
    <div class="card">
        <h1>Game Information</h1>
        <% data.forEach(item =>{ %>
            <div>
                <div>
                    <h6>Game ID</h6>
                    <p><%= item.game_id %></p>
                </div>
                
                <div>
                    <h6>Game Name</h6>
                    <p><%= item.game_name %></p>
                </div>

                <div>
                    <h6>Genre</h6>
                    <p><%= item.genre %></p>
                </div>
                
                <form action="/management/edit/<%= item.id %>" method="get">
                    <button>Edit</button>
                </form>

                <form action="/management/delete/<%= item.id %>" method="get">
                    <button>delete</button>
                </form>
            </div>
        <% }) %>
        
    </div>

    <div class="card">
        <h1>Developer Information</h1>
        <% data.forEach(item =>{ %>
            <div>
                <div>
                    <h6>Developer ID</h6>
                    <p><%= item.dev_id %></p>
                </div>
                
                <div>
                    <h6>Developer Name</h6>
                    <p><%= item.dev_name %></p>
                </div>
                

                <form action="/management/edit/<%= item.id %>" method="get">
                    <button>Edit</button>
                </form>

                <form action="/management/delete/<%= item.id %>" method="get">
                    <button>Delete</button>
                </form>
            </div>
        <% }) %>
    </div>
    
</section>