<%# ejs module  for edit inventory table %>
<link rel="stylesheet" href="./editTable.css">
<div class="editInventory">

    <div class="genre">
        <table>
            <thead>
                <tr>
                    <th>Available Genres</th>
                </tr>
            </thead>
            <tbody>
                <% genreData.forEach(item =>{ %>
                    <tr>
                        <td><%= item.genre %></td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
    
    <div class="dev">
        <table>
            <thead>
                <tr>
                    <th>Available Developers</th>
                </tr>
            </thead>
            <tbody>
                <% devData.forEach(item =>{ %>
                    <tr>
                        <td><%= item.dev_name %></td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>

    <div class="mainTable">
        <div class="inventoryButtons">
            <a href="/management/addGame"> <button>Add New Game</button> </a>
            <a href="/management/addGenre"> <button>Add New Genre</button> </a>
            <a href="/management/addDev"> <button>Add New Developer</button> </a>
        </div>

        <table>
            <thead>
                <tr>
                    <th>Game Name</th>
                    <th>Developer Name</th>
                    <th>Genres</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>
                <% Data.forEach(item => { %>
                    <tr>
                        <td><%= item.game_name %></td>
                        <td> <%= item.dev_name %></td>
                        <td>
                            <% item.genres.forEach(genre =>{ %>
                                <%= genre%>  
                            <% }) %>
                        </td>
                        <td>
                            <form action="/management/editGame/<%= item.game_id %>">
                                <button type="submit">Edit</button>
                            </form>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>

</div>

