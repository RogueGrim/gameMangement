<section>
    <table>
        <thead>
            <tr>
                <th>Developer</th>
                <th>Game(s)</th>
            </tr>
            
        </thead>
        <tbody>
            <% sortByDev.forEach(item =>{ %> 
                <tr>
                    <td><%= item.dev_name %></td>
                    <td>
                        <% for(item of item.game_names){ %>
                            <%= item %>,
                        <% } %>
                    </td>
                </tr>
            <% }) %>  
        </tbody>
    </table>
    
</section>