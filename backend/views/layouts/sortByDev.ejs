<div class="cardContainer" id="devData">
    <% devData.forEach(item => { %>
        <div class="entry">
            <h1><%= item.dev_name %></h1>
            <div class="card">
                <% item.game_names.forEach(entry =>{ %>
                    <div class="subCard">
                        <img src="./images/generic.jpg" alt="" class="gameImage">
                        <p class="information"><%= entry %></p>
                    </div>
                <% }) %>
            </div>
        </div>
    <% }) %>
</div>