<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add Game</title>
    <link rel="stylesheet" href="/addGame.css">
</head>
<body>
    <%- include('navbar',{title: 'Game Management App'}) %>
    <div class="back">
        <a href="/management"><button>Back</button></a>
    </div>
    <div class="container">
        <form action="/management/addGame/<%= id %>" method="post">
            <div class="nameField">
                <label for="game_name"> Game Name:</label>
                <input type="text" name="game_name" required>
            </div>
            
            <div class="genreField">
                <label for="genre">Genre: </label>
                <% genre.forEach(item => { %>
                    <label>
                        <input type="checkbox" name="genres" value="<%= item.genre_id %>">
                        <%= item.genre %>
                    </label>
                <% }) %>
            </div>
            <div class="selector">
                <label for="dev_name">Developer: </label>
                <select name="dev_id">
                    <option value="--">--</option>
                    <% dev.forEach(item => { %>
                        <option value="<%= item.dev_id %>"> <%= item.dev_name %> </option>
                    <% }) %>
                </select>
            </div>
            

            <button type="submit">Submit</button>
        </form>
    </div>
    
</body>
</html>